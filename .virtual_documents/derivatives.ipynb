h = 0.0001

# inputs
a = 2.0
b = -3.0
c = 10.0

d1 = a*b + c
a += h
d2 = a*b + c

print('d1', d1)
print('d2', d2)#tells us the sign/ inc or dec in the slope when changing our desired input (also called gradient)


h = 0.0001

# inputs
a = 2.0
b = -3.0
c = 10.0

d1 = a*b + c
c += h
d2 = a*b + c

print('d1', d1)
print('d2', d2)
print('slope', (d2 - d1)/h)#how much exactly the slope changes, cross checking by taking the derivative of d1 w.r.t c, we get 1



