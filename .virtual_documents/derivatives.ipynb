import math
import numpy as np
import matplotlib.pyplot as plt
%matplotlib inline


def f(x):
  return 3*x**2 - 4*x + 5 #any random func 


f(3.0)


xs = np.arange(-5, 5, 0.25)
ys = f(xs)
plt.plot(xs, ys)


h = 0.000001 #derivative would be how much the slope changes based on adding a very small value in the func
x = 2.0
f(x + h) #seeing the strength of the slope based on how much it changes
(f(x + h) - f(x))/h #the rise over run to get the slop


h = 0.000001
x = 2/3
(f(x + h) - f(x))/h #case when the slop doesnt change 


a = 2.0
