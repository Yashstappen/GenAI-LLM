b = {}
for w in words:
  chs = ['<S>'] + list(w) + ['<E>'] #special starting and ending char for every word
  for ch1, ch2 in zip(chs, chs[1:]): #zip allows to have 1-1 char together at a time
    bigram = (ch1, ch2)
    b[bigram] = b.get(bigram, 0) + 1 #defalt = 0, +1 when occurs


